BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
PORT=4000
WEBAPP_ORIGIN=http://localhost:4173

# Опционально: URL MongoDB. Если задан любой из них — данные в MongoDB, иначе в data/users.json
# Поддерживаются: MONGODB_URI, MONGO_URI, MONGO_URL, MONGODB_URL
# MONGODB_URI=mongodb://localhost:27017/farm
# Для Atlas: MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/farm?retryWrites=true&w=majority

